# Copy this file to .env and add your own values.
# Never commit the real .env file or API keys.

PORT=4000
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional: improves GitHub API rate limits and permits private-repository access.
# Use a fine-grained token with the minimum required read permissions.
GITHUB_TOKEN=

# Required for AI assessment and job-description parsing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash